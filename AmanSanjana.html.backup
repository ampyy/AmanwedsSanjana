<script id="watermark-remover">
// Remove watermarks injected by JS after page load
(function() {
  function removeWatermarks() {
    // Remove elements with Missingpiece links
    document.querySelectorAll('a[href*="missingpiecedesign"], a[href*="missingpieceinvites"]').forEach(function(el) {
      var container = el.closest('div') || el.parentElement;
      if (container) container.remove();
    });
    // Remove framer badge
    var badge = document.getElementById('__framer-badge-container');
    if (badge) badge.remove();
    // Remove watermark class elements
    document.querySelectorAll('.framer-yF5Cc, [data-framer-name="Watermark"]').forEach(function(el) {
      el.remove();
    });
  }
  // Run immediately and observe for dynamic injection
  document.addEventListener('DOMContentLoaded', removeWatermarks);
  var observer = new MutationObserver(removeWatermarks);
  observer.observe(document.documentElement, { childList: true, subtree: true });
  setTimeout(removeWatermarks, 500);
  setTimeout(removeWatermarks, 1500);
  setTimeout(removeWatermarks, 3000);
})();
</script>

